{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomframe.example/schemas/update-bundle.schema.json",
  "title": "RoomFrame offline update bundle",
  "type": "object",
  "required": ["formatVersion", "releaseId", "version", "createdAt", "preservesInstanceData", "signature", "artifacts"],
  "properties": {
    "formatVersion": {"const": 1},
    "releaseId": {"type": "string", "format": "uuid"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "minimumServerVersion": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "maximumServerVersion": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["amd64", "arm64"]}
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "kind"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 4294967296},
          "kind": {"enum": ["agent-apk", "home-apk", "server-archive", "oci-images", "migration", "compose-lock"]},
          "packageName": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
          },
          "versionCode": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "signingCertificateSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {"enum": ["agent-apk", "home-apk"]}
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "packageName": true,
                "versionCode": true,
                "signingCertificateSha256": true
              },
              "required": ["packageName", "versionCode", "signingCertificateSha256"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]{1,100}$"}
    },
    "preservesInstanceData": {"const": true}
  },
  "additionalProperties": false
}
