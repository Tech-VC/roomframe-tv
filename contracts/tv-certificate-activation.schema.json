{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomframe.example/schemas/tv-certificate-activation.schema.json",
  "title": "RoomFrame TV client certificate activation proof",
  "type": "object",
  "required": ["algorithm", "requestId", "fingerprintSha256", "proofSignature"],
  "properties": {
    "algorithm": {
      "const": "RS256"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "fingerprintSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofSignature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{342,1366}$"
    }
  },
  "additionalProperties": false
}
