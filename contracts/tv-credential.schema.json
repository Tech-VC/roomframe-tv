{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomframe.example/schemas/tv-credential.schema.json",
  "title": "RoomFrame TV credential rotation request",
  "oneOf": [
    {
      "type": "object",
      "required": ["nextKey", "currentGeneration"],
      "properties": {
        "nextKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32,200}$"
        },
        "currentGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["generation"],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  ]
}
