[Unit]
Description=RoomFrame TV client certificate broker
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=roomframe-tv-certificate-broker
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/roomframe-tv-certificate-broker/docker
ExecStart=/usr/local/sbin/roomframe-tv-certificate-broker
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
